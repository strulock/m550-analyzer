// Copy to wrangler.jsonc (git ignores it) and fill in your own IDs:
//   npx wrangler r2 bucket create n63read-logs
//   npx wrangler d1 create n63read
// ACCESS_AUD and ACCESS_TEAM_DOMAIN come from the Access application put in
// front of the Worker (see README.md); set them as secrets:
//   npx wrangler secret put ACCESS_AUD
//   npx wrangler secret put ACCESS_TEAM_DOMAIN
{
  "name": "n63read-cloud",
  "main": "src/worker.js",
  "compatibility_date": "2026-10-01",
  "workers_dev": true,
  // Or a custom domain on one of your zones, with workers_dev false so Access
  // on that hostname is the only way in:
  // "routes": [{ "pattern": "car.example.com", "custom_domain": true }],
  "r2_buckets": [
    { "binding": "FILES", "bucket_name": "n63read-logs" }
  ],
  "d1_databases": [
    { "binding": "DB", "database_name": "n63read", "database_id": "<your D1 database id>" }
  ],
  // The car's time zone: a drive log without a clock is dated in it, as the
  // logs' own clocks are (default America/Chicago). FIRMWARE_PUBLISHERS: the
  // service tokens (client IDs, comma-separated) that may publish the logger's
  // firmware besides your login: the app's, for publish_firmware.py.
  "vars": { "TIME_ZONE": "America/Chicago",
            "FIRMWARE_PUBLISHERS": "<app client ID>.access" },
  "observability": { "enabled": true }
}
